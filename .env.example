# Copy this file to .env.dev (local) or .env.prod and fill in real values.
# Do NOT commit files containing real secrets.
#
# This single file is consumed by BOTH workflows:
#   * Bare-metal `python run.py` (use localhost for REDIS_HOST / POSTGRES_HOST)
#   * `docker compose up` (the compose file overrides REDIS_HOST / POSTGRES_HOST
#     to the service names rtie-redis / rtie-postgres, so the values you put
#     here for those two keys don't matter for compose deployments)

# ============================================================
# REQUIRED — Oracle (OFSAA source database; external to compose)
# ============================================================
# When running `docker compose up` on a developer laptop and your Oracle
# instance lives on the same host, use host.docker.internal (Windows/Mac) or
# the Linux host's bridge IP. From bare-metal `python run.py`, use the
# Oracle host directly (e.g., localhost or its DNS name).
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SID=orclpdb
ORACLE_USER=your_oracle_user
ORACLE_PASSWORD=your_oracle_password

# ============================================================
# REQUIRED — Redis (containerized in compose)
# ============================================================
# Bare-metal workflow only — compose overrides this to `rtie-redis`.
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================================
# REQUIRED — Postgres (containerized in compose)
# ============================================================
# Bare-metal workflow only — compose overrides POSTGRES_HOST to
# `rtie-postgres`. POSTGRES_DB / USER / PASSWORD ARE consumed by compose
# (the postgres service uses them to initialize the volume), so the values
# here are real for compose users.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rtie
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# ============================================================
# REQUIRED — LLM provider (at least one of OPENAI / ANTHROPIC)
# ============================================================
# OpenAI (api.openai.com)
OPENAI_API_KEY=sk-your-openai-key

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Default model provider: "openai" or "anthropic"
DEFAULT_LLM_PROVIDER=openai
# Default model name per provider
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Embedding model for semantic search (must be an OpenAI embedding model;
# the indexer reads this from `EMBEDDING_MODEL`).
EMBEDDING_MODEL=text-embedding-3-small

# ============================================================
# OPTIONAL — Per-stage model overrides
# ============================================================
# JSON map of pipeline-stage -> {provider, model} to override defaults at
# fine granularity. See src/llm_factory.py for the schema. Leave unset
# unless you know you need it.
# Example:
#   RTIE_MODEL_OVERRIDES={"orchestrator": {"provider": "openai", "model": "gpt-4o-mini"}}
# RTIE_MODEL_OVERRIDES=

# ============================================================
# OPTIONAL — LangSmith tracing
# ============================================================
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_key
LANGSMITH_PROJECT=RTIE

# ============================================================
# Runtime
# ============================================================
# Selects .env.{ENVIRONMENT} and config/settings.{ENVIRONMENT}.yaml.
ENVIRONMENT=dev
